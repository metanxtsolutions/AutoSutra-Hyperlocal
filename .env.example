# AutoSutra Hyperlocal Ads: environment configuration
# Copy to .env.local for development. Never commit real values.
# Variables without NEXT_PUBLIC_ are server-only and never reach the browser.
# In production the app refuses to start with development defaults (see src/server/env.ts).

# --- Core -------------------------------------------------------------------
APP_URL=http://localhost:3000
DATABASE_URL=postgres://autosutra:autosutra@localhost:5432/autosutra_dev
# 32+ random characters. Used to key hashes of session, email and OAuth tokens.
#   openssl rand -base64 48
AUTH_SECRET=
# 32 random bytes, base64. Encrypts stored Meta/Google tokens (AES-256-GCM).
#   openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=
# Shared secret for /api/cron/* (Vercel Cron sends it as a Bearer token). 32+ chars.
CRON_SECRET=

# --- Email ------------------------------------------------------------------
# "outbox" stores messages in the database (visible at /dev/outbox in development).
# Production needs a transactional email provider driver; see docs/DEPLOYMENT.md.
EMAIL_DRIVER=outbox
EMAIL_FROM="AutoSutra <no-reply@example.com>"

# --- Creative asset storage ---------------------------------------------------
# local (development only) or s3 (any S3-compatible store: AWS S3, Cloudflare R2, MinIO)
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./storage
STORAGE_ENDPOINT=
STORAGE_REGION=auto
STORAGE_BUCKET=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=

# --- Meta Marketing API ---------------------------------------------------------
# off | demo | live. "demo" never contacts Meta and labels everything as demo.
# "live" also needs the live_meta_publishing feature flag in the admin console.
ADS_META_MODE=demo
META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=http://localhost:3000/api/oauth/meta/callback
META_GRAPH_VERSION=v23.0
# Objects are created PAUSED by default so first live publications cannot spend until resumed.
META_INITIAL_STATUS=PAUSED

# --- Google Ads API -------------------------------------------------------------
ADS_GOOGLE_MODE=demo
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/oauth/google/callback
GOOGLE_ADS_DEVELOPER_TOKEN=
# Manager (MCC) account id without dashes, when accessing customers through a manager.
GOOGLE_ADS_LOGIN_CUSTOMER_ID=
GOOGLE_ADS_API_VERSION=v21

# --- Payments -----------------------------------------------------------------
# mock (development: simulated gateway with signed webhooks) or razorpay
PAYMENT_GATEWAY=mock
PAYMENT_GATEWAY_KEY=
PAYMENT_GATEWAY_SECRET=
PAYMENT_WEBHOOK_SECRET=
# Must stay false until the funding model is approved. Also gated by feature flags.
PAYMENTS_LIVE=false

# --- Maps ---------------------------------------------------------------------
# Tile server for in-app maps. OpenStreetMap's public tiles are for light use only;
# use a commercial tile provider in production and add its host to the CSP in next.config.ts.
NEXT_PUBLIC_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
NEXT_PUBLIC_MAP_ATTRIBUTION="&copy; OpenStreetMap contributors"
# Reserved for server-side geocoding (not used yet).
MAPS_API_KEY=

# --- Monitoring -------------------------------------------------------------------
# Error monitoring DSN (e.g. Sentry). Structured JSON logs go to stdout regardless.
ERROR_MONITORING_DSN=

# --- Queue ----------------------------------------------------------------------
# Not required: background jobs use a Postgres-backed queue (see docs/ARCHITECTURE.md).
REDIS_URL=
